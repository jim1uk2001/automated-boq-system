BOJIM BOQ PRODUCTION SOFTWARE - CODE ANALYSIS
============================================

This document contains the two key files causing BOQ generation issues:
1. Duplicate items (items 31-33 repeating as 34-36 and 37-39)
2. Incorrect formatting with horizontal lines and colors

FILE 1: boq_generator.py
========================

```python
from typing import List, Dict, Any, Optional
import uuid
from ..models import BOQItem, Drawing, MeasurementStandard, DrawingType
from .drawing_processor import DrawingProcessor
import logging

logger = logging.getLogger(__name__)

class BOQGenerator:
    def __init__(self, measurement_standard: MeasurementStandard = MeasurementStandard.SMM7):
        self.measurement_standard = measurement_standard
        self.drawing_processor = DrawingProcessor()
        self.processed_drawings = set()  # Track processed drawings to prevent duplicates
        
        # Initialize measurement standard specific rules
        self._initialize_measurement_rules()
    
    def _initialize_measurement_rules(self):
        """Initialize measurement rules based on selected standard"""
        if self.measurement_standard == MeasurementStandard.SMM7:
            self.measurement_rules = {
                'concrete': {'unit': 'm³', 'deductions': True},
                'masonry': {'unit': 'm²', 'deductions': False},
                'excavation': {'unit': 'm³', 'deductions': True},
                'roofing': {'unit': 'm²', 'deductions': False}
            }
        elif self.measurement_standard == MeasurementStandard.RICS_NRM:
            self.measurement_rules = {
                'concrete': {'unit': 'm³', 'deductions': True},
                'masonry': {'unit': 'm²', 'deductions': True},
                'excavation': {'unit': 'm³', 'deductions': True},
                'roofing': {'unit': 'm²', 'deductions': True}
            }
        else:  # CESMM
            self.measurement_rules = {
                'concrete': {'unit': 'm³', 'deductions': False},
                'masonry': {'unit': 'm²', 'deductions': False},
                'excavation': {'unit': 'm³', 'deductions': False},
                'roofing': {'unit': 'm²', 'deductions': False}
            }

    async def generate_boq(self, drawings: List[Drawing]) -> List[BOQItem]:
        """Generate BOQ items from processed drawings"""
        boq_items = []
        
        # Process each drawing only once
        for drawing in drawings:
            drawing_id = str(drawing.id) if hasattr(drawing, 'id') else drawing.filename
            
            if drawing_id in self.processed_drawings:
                logger.info(f"Skipping already processed drawing: {drawing.filename}")
                continue
                
            self.processed_drawings.add(drawing_id)
            
            logger.info(f"Processing drawing: {drawing.filename}")
            
            # Process the drawing to extract elements
            processed_data = await self.drawing_processor.process_drawing(
                drawing.file_path if hasattr(drawing, 'file_path') else f"drawings/{drawing.filename}",
                drawing.drawing_type
            )
            
            # Generate BOQ items from processed data
            drawing_items = self._generate_items_from_drawing(processed_data, drawing)
            boq_items.extend(drawing_items)
            
            logger.info(f"Generated {len(drawing_items)} items from {drawing.filename}")
        
        return boq_items

    def _generate_items_from_drawing(self, processed_data: Dict[str, Any], drawing: Drawing) -> List[BOQItem]:
        """Generate BOQ items from a single processed drawing"""
        items = []
        
        # Extract elements from processed data
        elements = processed_data.get('elements', [])
        
        if drawing.drawing_type == DrawingType.ARCHITECTURAL:
            items.extend(self._process_architectural_elements(elements, drawing))
        elif drawing.drawing_type == DrawingType.STRUCTURAL:
            items.extend(self._process_structural_elements(elements, drawing))
        elif drawing.drawing_type == DrawingType.MEP:
            items.extend(self._process_mep_elements(elements, drawing))
        
        return items

    def _process_architectural_elements(self, elements: List[Dict], drawing: Drawing) -> List[BOQItem]:
        """Process architectural elements and generate BOQ items"""
        items = []
        
        for element in elements:
            element_type = element.get('type', 'unknown')
            
            if element_type == 'wall':
                items.append(self._create_wall_item(element, drawing))
            elif element_type == 'door':
                items.append(self._create_door_item(element, drawing))
            elif element_type == 'window':
                items.append(self._create_window_item(element, drawing))
            elif element_type == 'floor':
                items.append(self._create_floor_item(element, drawing))
            elif element_type == 'roof':
                items.append(self._create_roof_item(element, drawing))
        
        return [item for item in items if item is not None]

    def _process_structural_elements(self, elements: List[Dict], drawing: Drawing) -> List[BOQItem]:
        """Process structural elements and generate BOQ items"""
        items = []
        
        for element in elements:
            element_type = element.get('type', 'unknown')
            
            if element_type == 'foundation':
                items.append(self._create_foundation_item(element, drawing))
            elif element_type == 'beam':
                items.append(self._create_beam_item(element, drawing))
            elif element_type == 'column':
                items.append(self._create_column_item(element, drawing))
            elif element_type == 'slab':
                items.append(self._create_slab_item(element, drawing))
        
        return [item for item in items if item is not None]

    def _process_mep_elements(self, elements: List[Dict], drawing: Drawing) -> List[BOQItem]:
        """Process MEP elements and generate BOQ items"""
        items = []
        
        for element in elements:
            element_type = element.get('type', 'unknown')
            
            if element_type == 'electrical_outlet':
                items.append(self._create_electrical_outlet_item(element, drawing))
            elif element_type == 'lighting':
                items.append(self._create_lighting_item(element, drawing))
            elif element_type == 'plumbing_fixture':
                items.append(self._create_plumbing_item(element, drawing))
            elif element_type == 'hvac_unit':
                items.append(self._create_hvac_item(element, drawing))
        
        return [item for item in items if item is not None]

    def _create_wall_item(self, element: Dict, drawing: Drawing) -> Optional[BOQItem]:
        """Create BOQ item for wall element"""
        try:
            area = element.get('area', 0)
            if area <= 0:
                return None
                
            return BOQItem(
                id=str(uuid.uuid4()),
                project_id=drawing.project_id,
                item_code=f"A{len(self.processed_drawings):03d}",
                description=f"Wall construction - {element.get('material', 'standard')}",
                unit="m²",
                quantity=round(area, 2),
                category="masonry",
                trade="civil",
                measurement_standard=self.measurement_standard,
                drawing_reference=drawing.filename
            )
        except Exception as e:
            logger.error(f"Error creating wall item: {e}")
            return None

    def _create_door_item(self, element: Dict, drawing: Drawing) -> Optional[BOQItem]:
        """Create BOQ item for door element"""
        try:
            return BOQItem(
                id=str(uuid.uuid4()),
                project_id=drawing.project_id,
                item_code=f"B{len(self.processed_drawings):03d}",
                description=f"Door - {element.get('type', 'standard')} {element.get('width', 800)}mm x {element.get('height', 2100)}mm",
                unit="Nr",
                quantity=1,
                category="joinery",
                trade="carpentry",
                measurement_standard=self.measurement_standard,
                drawing_reference=drawing.filename
            )
        except Exception as e:
            logger.error(f"Error creating door item: {e}")
            return None

    def _create_window_item(self, element: Dict, drawing: Drawing) -> Optional[BOQItem]:
        """Create BOQ item for window element"""
        try:
            return BOQItem(
                id=str(uuid.uuid4()),
                project_id=drawing.project_id,
                item_code=f"C{len(self.processed_drawings):03d}",
                description=f"Window - {element.get('type', 'standard')} {element.get('width', 1200)}mm x {element.get('height', 1200)}mm",
                unit="Nr",
                quantity=1,
                category="glazing",
                trade="glazing",
                measurement_standard=self.measurement_standard,
                drawing_reference=drawing.filename
            )
        except Exception as e:
            logger.error(f"Error creating window item: {e}")
            return None

    def _create_floor_item(self, element: Dict, drawing: Drawing) -> Optional[BOQItem]:
        """Create BOQ item for floor element"""
        try:
            area = element.get('area', 0)
            if area <= 0:
                return None
                
            return BOQItem(
                id=str(uuid.uuid4()),
                project_id=drawing.project_id,
                item_code=f"D{len(self.processed_drawings):03d}",
                description=f"Floor finish - {element.get('material', 'standard')}",
                unit="m²",
                quantity=round(area, 2),
                category="flooring",
                trade="flooring",
                measurement_standard=self.measurement_standard,
                drawing_reference=drawing.filename
            )
        except Exception as e:
            logger.error(f"Error creating floor item: {e}")
