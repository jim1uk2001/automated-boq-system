                unit="m²",
                quantity=round(area, 2),
                category="roofing",
                trade="roofing",
                measurement_standard=self.measurement_standard,
                drawing_reference=drawing.filename
            )
        except Exception as e:
            logger.error(f"Error creating roof item: {e}")
            return None

    def _create_foundation_item(self, element: Dict, drawing: Drawing) -> Optional[BOQItem]:
        """Create BOQ item for foundation element"""
        try:
            volume = element.get('volume', 0)
            if volume <= 0:
